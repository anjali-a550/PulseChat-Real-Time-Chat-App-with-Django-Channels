# Copy to .env and change the secrets before deploying.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# false only for running the production build on plain http://localhost; true behind HTTPS.
DJANGO_SECURE_COOKIES=false

POSTGRES_DB=pulsechat
POSTGRES_USER=pulsechat
POSTGRES_PASSWORD=pulsechat
POSTGRES_PORT=5432

# Set by docker-compose; set it yourself when deploying elsewhere.
# REDIS_URL=redis://localhost:6379/0
